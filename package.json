    "check:class-exports": "bun run scripts/check-class-exports.ts",
    "build": "bun run scripts/build-test-point-rerouter-types.ts && tsup-node",
    "format": "biome format . --write",
    "measure-bundle": "howfat -r table .",
    "pkg-pr-new-release": "bunx pkg-pr-new publish --comment=off --peerDeps",
    "smoke-test:dist": "bun run scripts/smoke-tests/test-dist-assembly-bom.tsx && bun run scripts/smoke-tests/test-dist-simple-circuit.tsx && bun run scripts/smoke-tests/check-dist-bundled-schematic-solver.ts && bun run scripts/smoke-tests/test-dist-drawing-dimensions.tsx && bun run scripts/smoke-tests/check-dist-bundled-test-point-rerouter.ts && bun run scripts/smoke-tests/check-dist-collision-runtime.ts && bun run scripts/smoke-tests/test-dist-explosion-collisions.tsx && node scripts/smoke-tests/test-dist-node-explosion-collisions.mjs",
    "build:benchmarking": "bun build --experimental-html ./benchmarking/website/index.html --outdir ./benchmarking-dist",
    "build:benchmarking:watch": "chokidar \"./{benchmarking,lib}/**/*.{ts,tsx}\" -c 'bun build --experimental-html ./benchmarking/website/index.html --outdir ./benchmarking-dist'",
    "start:benchmarking": "concurrently \"bun run build:benchmarking:watch\" \"live-server ./benchmarking-dist\"",
    "generate-test-plan": "bun run scripts/generate-test-plan.ts",
    "benchmark:ddr": "bun scripts/benchmark-ddr/run.ts"
  },
