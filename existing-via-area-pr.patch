diff --git a/lib/autorouter-pipelines/AutoroutingPipeline9_PreloadedTraceGraph/markViaAreaBesideFixedCopper.ts b/lib/autorouter-pipelines/AutoroutingPipeline9_PreloadedTraceGraph/markViaAreaBesideFixedCopper.ts
